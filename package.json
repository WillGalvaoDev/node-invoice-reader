{
  "name": "docscan",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration:postgres": "vitest run --config vitest.integration.config.ts",
    "test:integration:postgres:docker": "node scripts/postgres-integration.mjs",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "lint": "eslint .",
    "start": "node src/index.js",
    "verify:production": "node scripts/verify-production-runtime.mjs",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs",
    "retention:ai-call-events": "node scripts/purge-ai-call-events.mjs",
    "reconcile:ai-usage": "node scripts/reconcile-ai-usage.mjs",
    "web:install": "npm --prefix web ci",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "web:test:e2e": "npm --prefix web run test:e2e",
    "render:build": "npm run prisma:generate && npm run build && npm run web:install && npm run web:build && npx prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.4",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.8.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unpdf": "^1.8.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.45.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
