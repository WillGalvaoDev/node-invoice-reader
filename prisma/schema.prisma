datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  // Relacionamentos
  ownedCompanies     Company[]                     @relation("CompanyOwner")
  collaborations     CompanyCollaborator[]
  auditLogs          AuditLog[]
  createdProducts    Product[]                     @relation("CreatedBy")
  decidedSuggestions ProductSimilaritySuggestion[] @relation("SuggestionDecidedBy")

  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique // 👈 Obrigatório e único
  ownerId   String
  createdAt DateTime @default(now())

  // Relacionamentos
  owner         User                  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stocks        Stock[]
  collaborators CompanyCollaborator[]
  auditLogs     AuditLog[]

  @@map("companies")
}

model CompanyCollaborator {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())

  // Relacionamentos
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions StockPermission[]

  @@unique([companyId, userId])
  @@map("company_collaborators")
}

model Stock {
  id        String   @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime @default(now())

  // Relacionamentos
  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products           Product[]
  permissions        StockPermission[]
  auditLogs          AuditLog[]
  processedInvoices  ProcessedInvoice[]
  productSuggestions ProductSimilaritySuggestion[]

  @@unique([companyId, name])
  @@map("stocks")
}

model ProcessedInvoice {
  id        String   @id @default(uuid())
  accessKey String   @unique
  stockId   String
  createdAt DateTime @default(now())

  stock              Stock                         @relation(fields: [stockId], references: [id], onDelete: Cascade)
  productSuggestions ProductSimilaritySuggestion[]

  @@map("processed_invoices")
}

model StockPermission {
  id             String  @id @default(uuid())
  collaboratorId String
  stockId        String
  canView        Boolean @default(false)
  canCreate      Boolean @default(false)
  canEdit        Boolean @default(false)
  canDelete      Boolean @default(false)

  // Relacionamentos
  collaborator CompanyCollaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  stock        Stock               @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, stockId])
  @@map("stock_permissions")
}

model Product {
  id              String   @id @default(uuid())
  code            String
  ean             String? // Opcional por enquanto
  ncm             String? // Opcional por enquanto
  description     String
  quantity        Decimal  @db.Decimal(12, 4)
  unitMeasurement String
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  // Relacionamento com Estoque
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Rastreabilidade de quem cadastrou
  userId                String?
  user                  User?                         @relation("CreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  similaritySuggestions ProductSimilaritySuggestion[] @relation("SuggestedProduct")

  @@unique([stockId, code])
  @@index([stockId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

enum ProductSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model ProductSimilaritySuggestion {
  id                  String                  @id @default(uuid())
  processedInvoiceId  String
  itemIndex           Int
  stockId             String
  suggestedProductId  String
  receivedCode        String
  receivedDescription String
  receivedQuantity    Decimal                 @db.Decimal(12, 4)
  receivedUnitPrice   Decimal                 @db.Decimal(12, 2)
  unitMeasurement     String
  confidence          Decimal                 @db.Decimal(5, 4)
  reason              String
  status              ProductSuggestionStatus @default(PENDING)
  decidedAt           DateTime?
  decidedByUserId     String?
  createdAt           DateTime                @default(now())

  processedInvoice ProcessedInvoice @relation(fields: [processedInvoiceId], references: [id], onDelete: Cascade)
  stock            Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)
  suggestedProduct Product          @relation("SuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Restrict)
  decidedByUser    User?            @relation("SuggestionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([processedInvoiceId, itemIndex])
  @@index([stockId, status])
  @@map("product_similarity_suggestions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  UNAUTHORIZED_ACCESS // 👈 Novo valor no Enum
}

model AuditLog {
  id            String      @id @default(uuid())
  companyId     String?
  stockId       String?
  userId        String?
  action        AuditAction
  details       String?
  entity        String
  entityId      String?
  description   String?
  previousState Json?
  newState      Json?
  createdAt     DateTime    @default(now())

  // Relacionamentos
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stock   Stock?   @relation(fields: [stockId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Cobrem exatamente os métodos reais IAuditLogRepository.findByCompanyId/findByUserId (where + orderBy createdAt desc).
  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
