datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  // Revogação determinística de token (P2-02): comparado com a claim do JWT,
  // não com timestamp — incrementar aqui invalida todo token emitido antes,
  // sem depender de comparação entre relógios distintos (ver justificativa na tarefa).
  authVersion Int      @default(1)
  createdAt   DateTime @default(now())

  // Relacionamentos
  ownedCompanies     Company[]                     @relation("CompanyOwner")
  collaborations     CompanyCollaborator[]
  auditLogs          AuditLog[]
  createdProducts    Product[]                     @relation("CreatedBy")
  decidedSuggestions ProductSimilaritySuggestion[] @relation("SuggestionDecidedBy")

  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique // 👈 Obrigatório e único
  ownerId   String
  createdAt DateTime @default(now())

  // Relacionamentos
  owner         User                  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stocks        Stock[]
  collaborators CompanyCollaborator[]
  auditLogs     AuditLog[]

  @@map("companies")
}

model CompanyCollaborator {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())

  // Relacionamentos
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions StockPermission[]

  @@unique([companyId, userId])
  @@map("company_collaborators")
}

model Stock {
  id        String   @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime @default(now())

  // Relacionamentos
  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products           Product[]
  permissions        StockPermission[]
  auditLogs          AuditLog[]
  processedInvoices  ProcessedInvoice[]
  productSuggestions ProductSimilaritySuggestion[]

  @@unique([companyId, name])
  @@map("stocks")
}

model ProcessedInvoice {
  id            String   @id @default(uuid())
  accessKey     String   @unique
  stockId       String
  // P3-01: liga a nota ao custo/telemetria em ai_call_events, sem nunca aparecer em log.
  correlationId String?
  createdAt     DateTime @default(now())

  stock              Stock                         @relation(fields: [stockId], references: [id], onDelete: Cascade)
  productSuggestions ProductSimilaritySuggestion[]

  @@map("processed_invoices")
}

model StockPermission {
  id             String  @id @default(uuid())
  collaboratorId String
  stockId        String
  canView        Boolean @default(false)
  canCreate      Boolean @default(false)
  canEdit        Boolean @default(false)
  canDelete      Boolean @default(false)

  // Relacionamentos
  collaborator CompanyCollaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  stock        Stock               @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, stockId])
  @@map("stock_permissions")
}

model Product {
  id              String   @id @default(uuid())
  code            String
  ean             String? // Opcional por enquanto
  ncm             String? // Opcional por enquanto
  description     String
  quantity        Decimal  @db.Decimal(12, 4)
  unitMeasurement String
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  // Relacionamento com Estoque
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Rastreabilidade de quem cadastrou
  userId                String?
  user                  User?                         @relation("CreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  similaritySuggestions ProductSimilaritySuggestion[] @relation("SuggestedProduct")

  @@unique([stockId, code])
  @@index([stockId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

enum ProductSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model ProductSimilaritySuggestion {
  id                  String                  @id @default(uuid())
  processedInvoiceId  String
  itemIndex           Int
  stockId             String
  suggestedProductId  String
  receivedCode        String
  receivedDescription String
  receivedQuantity    Decimal                 @db.Decimal(12, 4)
  receivedUnitPrice   Decimal                 @db.Decimal(12, 2)
  unitMeasurement     String
  confidence          Decimal                 @db.Decimal(5, 4)
  reason              String
  status              ProductSuggestionStatus @default(PENDING)
  decidedAt           DateTime?
  decidedByUserId     String?
  createdAt           DateTime                @default(now())

  processedInvoice ProcessedInvoice @relation(fields: [processedInvoiceId], references: [id], onDelete: Cascade)
  stock            Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)
  suggestedProduct Product          @relation("SuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Restrict)
  decidedByUser    User?            @relation("SuggestionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([processedInvoiceId, itemIndex])
  @@index([stockId, status])
  @@map("product_similarity_suggestions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  UNAUTHORIZED_ACCESS // 👈 Novo valor no Enum
}

model AuditLog {
  id            String      @id @default(uuid())
  companyId     String?
  stockId       String?
  userId        String?
  action        AuditAction
  details       String?
  entity        String
  entityId      String?
  description   String?
  previousState Json?
  newState      Json?
  createdAt     DateTime    @default(now())

  // Relacionamentos
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stock   Stock?   @relation(fields: [stockId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Cobrem exatamente os métodos reais IAuditLogRepository.findByCompanyId/findByUserId (where + orderBy createdAt desc).
  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// P3-01: observabilidade de chamadas de IA, nunca autoridade de gasto (ver ai_usage_ledger, P4-02).
// Escrita best-effort e fora de qualquer transação de domínio — perder uma linha aqui nunca reverte uma nota.
// Sem FK para User/Company/Stock: tabela de alto volume e best-effort, deliberadamente desacoplada do
// ciclo de vida dessas entidades (nenhuma consulta desta tarefa navega a relação via Prisma).
model AiCallEvent {
  id                    String   @id @default(uuid())
  correlationId         String
  requestId             String?
  operation             String
  model                 String
  modelVersion          String?
  status                String
  durationMs            Float
  attempts              Int
  inputTokens           Int?
  outputTokens          Int?
  totalTokens           Int?
  estimatedCostUsdNanos Int?
  failureCategory       String?
  userId                String?
  companyId             String?
  stockId               String?
  createdAt             DateTime @default(now())

  @@index([createdAt])
  @@index([correlationId])
  @@index([operation, createdAt])
  @@map("ai_call_events")
}

// P4-02 (D8): registro autoritativo que decide se uma chamada ao Gemini pode acontecer —
// escrita forte, fail-closed, nunca best-effort (contrato oposto de ai_call_events).
// scope 'global' usa scopeId = 'global' (sentinela); scope 'user' usa scopeId = userId.
// periodKind hoje só usa 'day' (Modo A); 'month' fica reservado para o Modo B (custo).
// reservedTokens/spentTokens e reservedCostUsdNanos/spentCostUsdNanos acumulam desde já
// (mesmo padrão já usado para custo em ai_call_events): sem teto configurado nesta
// primeira versão do Modo A (D8 — ausência deliberada de dado empírico para TPD), só
// observação. Nenhuma leitura de ai_call_events participa desta decisão (P4-02 não
// depende de P3-01) — a única fonte de verdade aqui é esta própria tabela.
model AiUsageLedger {
  id                   String   @id @default(uuid())
  scope                String
  scopeId              String
  periodKind           String
  period               String
  reservedRequests     Int      @default(0)
  spentRequests        Int      @default(0)
  reservedTokens       Int      @default(0)
  spentTokens          Int      @default(0)
  reservedCostUsdNanos Int      @default(0)
  spentCostUsdNanos    Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@unique([scope, scopeId, periodKind, period])
  @@map("ai_usage_ledger")
}
