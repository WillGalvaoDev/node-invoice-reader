# Required runtime configuration
DATABASE_URL=postgresql://user:password@localhost:5432/docscan
# JWT_SECRET must be at least 32 characters (fail-fast below that). Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters
GEMINI_API_KEY=replace-with-your-api-key
# Shared invite code required to register during the pilot (P4-03). At least 8
# characters. Never commit the real value; rotate by changing this variable
# and restarting — no deploy needed.
INVITE_CODE=replace-with-a-shared-invite-code

# HTTP defaults
PORT=3333
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=30000

# Gemini resilience defaults
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=2

# Similarity matching: single source for the threshold used in both the prompt
# and the code decision (0-1). Do not change without real usage data (see M6-02).
SIMILARITY_CONFIDENCE_THRESHOLD=0.7

# Max product lines accepted per DANFE upload (P4-01). Pilot operational ceiling
# (docs/pilot-decisions.md, D1), not a fiscal rule. Single source for both the
# Gemini prompt's maxItems and the schema validation.
DANFE_MAX_ITEMS=100
