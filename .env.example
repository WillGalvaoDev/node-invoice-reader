# Required runtime configuration
DATABASE_URL=postgresql://user:password@localhost:5432/docscan
JWT_SECRET=replace-with-a-strong-secret
GEMINI_API_KEY=replace-with-your-api-key

# HTTP defaults
PORT=3333
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=30000

# Gemini resilience defaults
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=2

# Similarity matching: single source for the threshold used in both the prompt
# and the code decision (0-1). Do not change without real usage data (see M6-02).
SIMILARITY_CONFIDENCE_THRESHOLD=0.7
